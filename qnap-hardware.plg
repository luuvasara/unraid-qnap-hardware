<?xml version='1.0' standalone='yes'?>
<!DOCTYPE PLUGIN [
  <!ENTITY name    "qnap-hardware">
  <!ENTITY author  "QNAP Hardware project">
  <!ENTITY version "2026.11.08a">
  <!ENTITY gitURL  "https://raw.githubusercontent.com/luuvasara/unraid-qnap-hardware/main">
  <!ENTITY pluginURL "&gitURL;/qnap-hardware.plg">
  <!ENTITY pkg     "qnap-hardware-&version;-x86_64-1.txz">
  <!ENTITY pkgURL  "&gitURL;/packages/&pkg;">
  <!ENTITY md5     "e02e27f5ddcf35730bb3f664daa6ed84">
]>
<!-- QNAP Hardware: the overview, history, inventory and report of a QNAP TL-D1600S JBOD enclosure. The enclosure geometry is a
     profile of the plugin kit; the pages read sysfs and Unraid's own state. One cron line (a history sample a minute, RAM only)
     while HISTORY=yes. Bump &version; on EVERY change; &md5; is filled in by build.sh from the built txz, never by hand. -->
<PLUGIN name="&name;" author="&author;" version="&version;" min="6.12.0" launch="Utilities/QnapHW" icon="qnap-hardware.png" pluginURL="&pluginURL;">

<CHANGES>
###2026.11.08a
- First version. Utilities, QNAP Hardware, for a QNAP TL-D1600S on its QXP-1600eS-A1164 card.
- Overview: a live front view of the enclosure as its bays are labelled (HDD1-HDD12, SSD1-SSD4), each drive with its Unraid slot, temperature and state as Unraid last read them (no drive is woken), redrawn every 10 seconds; one card per unit (drives, hottest drive, health, card link, cabling); the bay map.
- Bay labels on the Main page: "HDD3" after each drive's name (setting on the Overview tab, on by default).
- History: drive temperatures per bay over 1, 6 or 24 hours, from one sample a minute kept in RAM (setting on the Overview tab; off = nothing runs in the background), with the same numbers as a table.
- Hardware: the card's PCIe links and error counters, the controllers' capabilities, each drive's SATA link, firmware and SMART counters; known issues checked against this server; what firmware can and cannot be read.
- Fans and LEDs: the enclosure runs them itself and the server has no way to reach them; the Hardware tab says so and why.
- Report: a read-only hardware report, anonymised on the server, to copy, download or open as an issue.
</CHANGES>

<!-- pre-install: dirs, the install mode for the notes, version-preserving cleanup of old packages on flash -->
<FILE Run="/bin/bash">
<INLINE>
mkdir -p /boot/config/plugins/&name; /var/run/&name;
OLD=
for f in /var/log/packages/&name;-*-x86_64-1; do
  if [ -e "$f" ]; then OLD=${f##*/&name;-}; OLD=${OLD%-x86_64-1}; fi
done
if [ -n "$OLD" ]; then echo "update $OLD"
elif [ -e /boot/config/plugins/&name;.plg ]; then echo boot
else echo fresh
fi &gt;/var/run/&name;/install-from
for f in /boot/config/plugins/&name;/&name;-*-x86_64-1.txz; do
  case $f in */&name;-&version;-x86_64-1.txz) ;; *) if [ -f "$f" ]; then rm -f "$f"; fi ;; esac
done
</INLINE>
</FILE>

<!-- payload: downloaded to the flash (MD5 checked after the download, and for the flash copy at every boot), then upgradepkg -->
<FILE Name="/boot/config/plugins/&name;/&pkg;" Run="upgradepkg --install-new --reinstall">
<URL>&pkgURL;</URL>
<MD5>&md5;</MD5>
</FILE>

<!-- post-install: default settings once, the history cron line (Unraid's update_cron reads plugin cron files only of plugins
     listed in /var/log/plugins, which this plugin is once the install finishes: so it runs detached, a few seconds later).
     Never fails: a failing Run at boot moves the .plg to plugins-error. -->
<FILE Run="/bin/bash">
<INLINE>
P=/usr/local/emhttp/plugins/&name;
[ -f /boot/config/plugins/&name;/&name;.cfg ] || cp $P/default/&name;.cfg /boot/config/plugins/&name;/&name;.cfg
setsid bash -c "sleep 10; $P/scripts/qnaphw-apply" &lt;/dev/null &gt;/dev/null 2&gt;&amp;1 &amp;
MODE=; OLD=
read -r MODE OLD 2&gt;/dev/null &lt;/var/run/&name;/install-from
FIRST_RUN="Utilities, QNAP Hardware shows the enclosure. Install QNAP Expansion too for the card checks, Locate and the cabling check." \
  $P/kit/install-notes.sh "&version;" "$MODE" "$OLD" || true
rm -f /var/run/&name;/install-from
exit 0
</INLINE>
</FILE>

<!-- remove: the cron line, the package and the runtime dir (the history); the settings stay on the flash for a reinstall -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
rm -f /boot/config/plugins/&name;/&name;.cron
removepkg &name;-&version;-x86_64-1
/usr/local/sbin/update_cron
rm -rf /var/run/&name;
rm -f /boot/config/plugins/&name;/&pkg;
echo "qnap-hardware removed. Settings are kept in /boot/config/plugins/&name;/ (delete that folder to forget them)."
exit 0
</INLINE>
</FILE>

</PLUGIN>
