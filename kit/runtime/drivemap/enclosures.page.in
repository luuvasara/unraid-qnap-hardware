Menu="@@PARENT@@:@@ENCLOSURES_ORDER@@"
Title="Enclosures"
Tag="th"
Markdown="false"
---
<?php
/* Enclosures: made by the build from the plugin kit. Each disk enclosure the kit has a profile for (kit/enclosures/*.json):
 * the card and its PCIe links, a front view with the drive in each bay and its state as Unraid last read it (no drive is
 * woken), the bay table with Locate, and the cabling confirmation. Read-only except Locate (a read) and the two settings.
 * Logic: kit/EnclosureView.php; endpoint: kit/enclosures.php (POST, Unraid checks the token); drawn with textContent. */
$enc_slug = '@@NAME@@';
$enc_root = ($docroot ?? '/usr/local/emhttp') . "/plugins/$enc_slug/kit";
require_once "$enc_root/EnclosureView.php";
require_once "$enc_root/Locate.php";
$enc_cfgdir = rtrim((string)(getenv('DRIVEMAP_ROOT') ?: ''), '/') . "/boot/config/plugins/$enc_slug";
$enc_cfg = (@parse_ini_file("$enc_cfgdir/$enc_slug.cfg") ?: []) + ['MAIN_BADGES' => 'yes'];
$enc_view = enclosure_view(['cabling_file' => "$enc_cfgdir/enclosures.json"]);
$enc_h = function ($s) { return htmlspecialchars((string)$s, ENT_QUOTES, 'UTF-8'); };
$enc_icon = ENCLOSURE_ICON;
$enc_smart = ['healthy' => 'fa-thumbs-o-up green-text', 'error' => 'fa-thumbs-o-down orange-text', 'failed' => 'fa-thumbs-o-down red-text'];
$enc_temp = 'enclosure_temp_text';
$enc_v = substr(md5((string)@md5_file("$enc_root/enclosures.js") . @md5_file("$enc_root/enclosures.css")), 0, 10);
?>
<link rel="stylesheet" href="/plugins/<?=$enc_slug?>/kit/enclosures.css?v=<?=$enc_v?>">
<div class="enc" id="enc-<?=$enc_slug?>" data-endpoint="/plugins/<?=$enc_slug?>/kit/enclosures.php" data-seconds="<?=DriveLocate::SECONDS?>">
<?php if (!$enc_view['units']): ?>
<div class="title"><span class="left"><i class="fa fa-th title"></i>No enclosure found</span></div>
<p class="enc-p">No card of a known disk enclosure is in this server. Known: <?=$enc_h(implode(', ', array_map(function ($p) { return $p['name'] . (!empty($p['card']) ? " on its {$p['card']} card" : ''); }, $enc_view['profiles'])))?>.</p>
<?php endif; ?>
<?php foreach ($enc_view['candidates'] as $c): ?>
<p class="enc-p"><i class="fa fa-info-circle" aria-hidden="true"></i> A controller at <?=$enc_h($c['address'])?> (<?=$enc_h($c['id'])?>, subsystem <?=$enc_h($c['subsystem'])?>) is from the same maker as the <?=$enc_h($enc_view['profiles'][$c['profile']]['name'])?> card, but it is not laid out like it, so its drives are not placed in bays.</p>
<?php endforeach; ?>
<?php foreach ($enc_view['units'] as $u): $uid = $enc_h("{$u['profile']}-{$u['unit']}"); $mapped = $u['cabling'] && $u['ports_known']; ?>
<div class="title"><span class="left"><i class="fa fa-th title"></i><?=$enc_h("{$u['name']} {$u['unit']}")?></span>
  <span class="enc-sub"><?=$enc_h(trim(($u['card'] !== '' ? "{$u['card']} card" : 'card') . " at {$u['switch']}"))?></span></div>
<p class="enc-p"><?php if (!$mapped): ?>The bays of this enclosure are not mapped yet: its drives are listed by the card's controller (in PCI order) and port.
<?php elseif ($u['confirmed']): ?><i class="fa fa-check green-text" aria-hidden="true"></i> Cabling confirmed: every drive is shown in its bay.
<?php else: ?><i class="fa fa-warning orange-text" aria-hidden="true"></i> Cabling not confirmed. Which controller of the card feeds which group of bays depends on how the cables are plugged. The bays below follow the unit the profile was measured on. Locate a drive and check that its light flashes in the bay shown; if it does not, set the cabling below.<?php endif; ?></p>

<?=enclosure_front_html($u)?>

<div class="enc-scroll"><table class="unraid enc-t">
<caption class="enc-cap">Bays of <?=$enc_h("{$u['name']} {$u['unit']}")?></caption>
<thead><tr><th scope="col">Bay</th><th scope="col">Device</th><th scope="col">Slot</th><th scope="col">Model</th><th scope="col">Size</th><th scope="col">Temp.</th><th scope="col">State</th><th scope="col">SMART</th><th scope="col"><span class="enc-sr">Actions</span></th></tr></thead>
<tbody>
<?php foreach ($u['bays'] as $b): if ($b['device'] === '') continue; ?>
<tr data-enc-dev="<?=$enc_h($b['device'])?>" data-enc-standby="<?=$b['standby'] ? '1' : '0'?>">
  <th scope="row"><?=$enc_h($b['bay'])?></th><td><?=$enc_h($b['device'])?></td><td><?=$enc_h($b['slot'] !== '' ? $b['slot'] : '-')?></td>
  <td><?=$enc_h($b['model'])?></td><td><?=$enc_h(enclosure_size($b['size']))?></td><td><?=$enc_h($enc_temp($b))?></td>
  <td><i class="fa <?=$enc_icon[$b['state']] ?? ''?>" aria-hidden="true"></i> <?=$enc_h($b['state_text'])?></td>
  <td title="<?=$enc_h($b['smart']['title'])?>"><?php if (isset($enc_smart[$b['smart']['state']])): ?><i class="fa <?=$enc_smart[$b['smart']['state']]?>" aria-hidden="true"></i> <?php endif; ?><?=$enc_h($b['smart']['text'])?></td>
  <td class="enc-act"><input type="button" class="enc-loc" value="Locate" aria-label="Locate <?=$enc_h($b['device'])?> in <?=$enc_h($b['bay'])?>"></td>
</tr>
<?php endforeach; ?>
<?php foreach ($u['unplaced_rows'] as $r): ?>
<tr data-enc-dev="<?=$enc_h($r['device'])?>"><th scope="row">-</th><td><?=$enc_h($r['device'])?></td><td colspan="6"><?=$enc_h("{$r['model']}: {$r['label']}")?></td>
  <td class="enc-act"><input type="button" class="enc-loc" value="Locate" aria-label="Locate <?=$enc_h($r['device'])?>"></td></tr>
<?php endforeach; ?>
</tbody></table></div>
<p class="enc-msg" data-enc="locout" role="status" aria-live="polite"></p>

<?php if ($u['links']): ?>
<div class="enc-scroll"><table class="unraid enc-t enc-links">
<caption class="enc-cap">PCIe links of the card: negotiated, and what both ends of each link can do</caption>
<thead><tr><th scope="col">Link</th><th scope="col">Address</th><th scope="col">Negotiated</th><th scope="col">Expected</th><th scope="col">State</th></tr></thead>
<tbody>
<?php foreach ($u['links'] as $l): $ok = $l['state'] === 'ok'; ?>
<tr><th scope="row"><?=$enc_h($l['name'])?></th>
  <td><?=$enc_h($l['to'])?></td><td><?=$enc_h(enclosure_link_text($l['speed'], $l['width']))?></td><td><?=$enc_h(enclosure_link_text($l['want_speed'], $l['want_width']))?></td>
  <td><i class="fa <?=$ok ? 'fa-check green-text' : ($l['state'] === 'unknown' ? 'fa-question-circle' : 'fa-warning orange-text')?>" aria-hidden="true"></i> <?=$enc_h($ok ? 'full speed' : ($l['state'] === 'unknown' ? 'unknown' : "trained down: {$l['state']}"))?></td></tr>
<?php endforeach; ?>
</tbody></table></div>
<?php endif; ?>

<?php if ($mapped): ?>
<form class="enc-cab" data-enc="cabling" data-switch="<?=$enc_h($u['switch'])?>">
<fieldset><legend><?=$u['confirmed'] ? 'Cabling' : 'Confirm the cabling'?></legend>
<p class="enc-p">Each controller of the card serves one cable, and each cable feeds one group of bays. ex. Locate the drive shown in HDD1: if the light flashes in HDD5 instead, pick HDD5-HDD8 for that drive's controller. Saved in <code>/boot/config/plugins/<?=$enc_h($enc_slug)?>/enclosures.json</code>.</p>
<?php foreach ($u['controllers'] as $enc_ci => $ctl): ?>
<div class="enc-field"><label for="enc-cab-<?=$uid?>-<?=$enc_ci?>">Controller <?=$enc_ci + 1?> (<?=$enc_h($ctl)?>) feeds</label>
<select id="enc-cab-<?=$uid?>-<?=$enc_ci?>" name="order[]">
<?php foreach ($u['groups'] as $gk => $bays): ?><option value="<?=$enc_h($gk)?>"<?=((string)($u['cabling'][$enc_ci] ?? '') === (string)$gk) ? ' selected' : ''?>><?=$enc_h(reset($bays) . '-' . end($bays))?></option><?php endforeach; ?>
</select></div>
<?php endforeach; ?>
<div class="enc-field"><input type="submit" value="<?=$u['confirmed'] ? 'Save cabling' : 'Confirm cabling'?>"> <span data-enc="cabout" role="status" aria-live="polite"></span></div>
</fieldset>
</form>
<?php endif; ?>

<?php if ($u['notes']): ?>
<details class="enc-notes"><summary>What the server can see of this enclosure</summary><ul>
<?php foreach ($u['notes'] as $n): ?><li><?=$enc_h($n)?></li><?php endforeach; ?>
</ul></details>
<?php endif; ?>
<?php endforeach; ?>

<?php if ('@@ENCLOSURE_BADGES@@' === 'yes'): ?>
<form class="enc-set" method="POST" action="/update.php" target="progressFrame">
<input type="hidden" name="#file" value="<?=$enc_h($enc_slug)?>/<?=$enc_h($enc_slug)?>.cfg">
<fieldset><legend>Main page</legend>
<div class="enc-field"><label for="enc-badges-<?=$enc_slug?>">Bay labels on the Main page</label>
<select id="enc-badges-<?=$enc_slug?>" name="MAIN_BADGES" aria-describedby="enc-badges-help-<?=$enc_slug?>">
<option value="yes"<?=$enc_cfg['MAIN_BADGES'] !== 'no' ? ' selected' : ''?>>Yes</option>
<option value="no"<?=$enc_cfg['MAIN_BADGES'] === 'no' ? ' selected' : ''?>>No</option>
</select></div>
<p class="enc-p" id="enc-badges-help-<?=$enc_slug?>">Shows the bay next to each drive's name on the Main page, ex. "HDD3", so a drive in the list can be found in the enclosure. Visual only; reload the Main page after Apply.</p>
<div class="enc-field"><input type="submit" value="Apply"></div>
</fieldset>
</form>
<?php endif; ?>
</div>
<script src="/plugins/<?=$enc_slug?>/kit/enclosures.js?v=<?=$enc_v?>"></script>
